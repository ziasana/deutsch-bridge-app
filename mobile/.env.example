# Base URL of the Spring Boot backend (no trailing slash, no /api suffix).
# iOS simulator:      http://localhost:8080
# Android emulator:   http://10.0.2.2:8080
# Physical device:    http://<your-LAN-ip>:8080
# Production builds must use https (enforced in src/config/env.ts).
EXPO_PUBLIC_API_URL=http://localhost:8080

# Dev only: set to 1 to open the onboarding wizard without an account (saves nothing).
# EXPO_PUBLIC_ONBOARDING_PREVIEW=1

# Dev only: log every API request's time and size ([api] GET /grammar 200 120ms 14.2KB; >1s warns).
# EXPO_PUBLIC_API_TIMING=1

# Google sign-in OAuth client IDs (Google Cloud Console > Credentials). The web client ID is also the
# one the backend must list in GOOGLE_CLIENT_IDS. The iOS client ID is optional on Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
