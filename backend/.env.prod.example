# Copy to .env.prod (gitignored) and fill in real values, or set these as
# environment variables directly in your deployment platform.

SPRING_PROFILES_ACTIVE=prod

# --- Email (SMTP relay - defaults to Brevo, see application-prod.yml for why) ---
# Sign up at https://www.brevo.com, verify a sender email/domain, then generate SMTP
# credentials under SMTP & API settings - MAIL_USERNAME/PASSWORD are the SMTP login/key
# it gives you, not your Brevo account email/password.
# On a host that doesn't block SMTP ports, you can instead set MAIL_HOST=smtp.gmail.com,
# MAIL_PORT=587, and use a Gmail address + App Password here.
MAIL_USERNAME=your-smtp-login
MAIL_PASSWORD=your-smtp-key

# --- Database / other secrets (see backend/.env for local equivalents) ---
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
MONGODB_URI=
POSTGRES_URI=
OLLAMA_API_KEY=
OLLAMA_API_URI=
JWT_SECRET=
FRONTEND_URI=

# Sender shown in the inbox. Keep it short (cut off after ~25 characters on phones).
MAIL_FROM_NAME=Deutsch Certify Team

# Google sign-in: comma-separated OAuth client IDs whose ID tokens are accepted (the web client ID, plus iOS/Android for the app).
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com
